# myapi 環境変数サンプル. ファイル名は `.env` にリネーム.
# 値は Pydantic Settings (env_prefix=MYAPI_, env_nested_delimiter=__) で読み込まれる.

MYAPI_REDIS_HOST=localhost
MYAPI_REDIS_PORT=6379
MYAPI_REDIS_DB=0
MYAPI_USER_CACHE_TTL_SECONDS=60

# レートリミット設定. `RatelimitSettings` の各フィールドを __ 区切りで上書き.
MYAPI_RATELIMIT__LIMIT=60
MYAPI_RATELIMIT__WINDOW_SECONDS=60
MYAPI_RATELIMIT__TARGET_PATH_PREFIXES=["/users","/orders"]
MYAPI_RATELIMIT__EXCLUDED_PATHS=["/health","/openapi.json","/docs"]
